# Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Fivetran API credentials
FIVETRAN_API_KEY=
FIVETRAN_API_SECRET=
FIVETRAN_GROUP_ID=

# Fivetran run behavior
FIVETRAN_DRY_RUN=true
FIVETRAN_RUN_SYNC=true
FIVETRAN_SCHEMA_PREFIX=syncy
FIVETRAN_SYNC_FREQUENCY=60

# Optional per-connector config JSON
FIVETRAN_CONNECTOR_CONFIGS={}
